# FairScreen environment variables. Copy to .env and adjust.
# Demo mode needs no keys: leave LLM_PROVIDER=mock.

# --- Core ---
# Runtime environment label. Values: dev, test, prod.
FAIRSCREEN_ENV=dev
# SQLAlchemy database URL. SQLite locally, Postgres-compatible.
DATABASE_URL=sqlite:///./data/fairscreen.db
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Random seed for CV generation, bootstrap, permutation, and mock noise.
FAIRSCREEN_SEED=2026
# Default repeats per variant.
FAIRSCREEN_REPEATS=3
# Default shortlist cutoff on the 0 to 10 scale.
FAIRSCREEN_SHORTLIST_CUTOFF=7.0
# Default budget cap in USD for a run.
FAIRSCREEN_BUDGET_USD=5.0
# Bootstrap and permutation resample counts.
FAIRSCREEN_BOOTSTRAP=10000
FAIRSCREEN_PERMUTATION=10000
# Enable the database-backed score cache.
FAIRSCREEN_CACHE_ENABLED=true

# --- Provider selection ---
# Values: mock, openai, anthropic, gemini.
LLM_PROVIDER=mock
# Temperature passed to real providers.
LLM_TEMPERATURE=0.2
# Maximum retry attempts for real provider HTTP and validation failures.
LLM_MAX_RETRIES=3
# Per-request timeout in seconds.
LLM_TIMEOUT_SECONDS=60

# --- OpenAI-compatible provider ---
# Leave empty for demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Prices per million tokens, used for the budget cap.
OPENAI_INPUT_PRICE_PER_MTOK=0.15
OPENAI_OUTPUT_PRICE_PER_MTOK=0.60

# --- Anthropic-compatible provider ---
# Leave empty for demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_INPUT_PRICE_PER_MTOK=0.80
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=4.00
ANTHROPIC_MAX_TOKENS=400

# --- Google Gemini provider ---
# Leave empty for demo mode.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
# Prices per million tokens, used for the budget cap.
GEMINI_INPUT_PRICE_PER_MTOK=0.075
GEMINI_OUTPUT_PRICE_PER_MTOK=0.30
GEMINI_MAX_TOKENS=400

# --- Web ---
# Browser-facing API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Ports used by the dev helper.
FAIRSCREEN_API_PORT=8000
FAIRSCREEN_WEB_PORT=3000
